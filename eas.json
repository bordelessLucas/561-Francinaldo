{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "22.14.0"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "22.14.0",
      "env": {
        "EXPO_PUBLIC_ENABLE_STORAGE_UPLOAD": "false",
        "EXPO_PUBLIC_AI_MODEL": "gpt-4o-mini"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "node": "22.14.0",
      "env": {
        "EXPO_PUBLIC_ENABLE_STORAGE_UPLOAD": "false",
        "EXPO_PUBLIC_AI_MODEL": "gpt-4o-mini"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
