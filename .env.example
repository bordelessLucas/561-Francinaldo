# Firebase (públicos no app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Análise — mock | openai (4B Vision efêmera, sem Storage)
EXPO_PUBLIC_AI_PROVIDER=mock
EXPO_PUBLIC_AI_MODEL=gpt-4o-mini
# Produção: URL do site Netlify (ex.: https://seu-site.netlify.app). Vazio = fallback com chave no app (só piloto).
EXPO_PUBLIC_AI_ANALYZE_URL=
# Segredo — NUNCA use prefixo EXPO_PUBLIC_. Netlify env: OPENAI_API_KEY. Local: app.config.js.
OPENAI_API_KEY=
EXPO_PUBLIC_ENABLE_STORAGE_UPLOAD=false
EXPO_PUBLIC_AI_FORCE_FAIL=false
