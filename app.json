{
  "expo": {
    "name": "Vistora",
    "slug": "vistora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vistora",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.francinaldo.vistora",
      "infoPlist": {
        "NSCameraUsageDescription": "Vistora precisa da câmera para registrar situações de campo.",
        "NSPhotoLibraryUsageDescription": "Vistora precisa acessar fotos para análise de riscos em campo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#146C6A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.francinaldo.vistora",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EEF3F5"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir acesso à galeria para selecionar imagens de campo.",
          "cameraPermission": "Permitir acesso à câmera para fotografar situações de risco."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
