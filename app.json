{
  "expo": {
    "name": "Alpha SST",
    "slug": "alpha-sst",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "alphasst",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.francinaldo.alphasst",
      "infoPlist": {
        "NSCameraUsageDescription": "Alpha SST precisa da câmera para registrar situações de campo.",
        "NSPhotoLibraryUsageDescription": "Alpha SST precisa acessar fotos para análise de riscos em campo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#084828",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.francinaldo.alphasst",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/alpha-sst-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir acesso à galeria para selecionar imagens de campo.",
          "cameraPermission": "Permitir acesso à câmera para fotografar situações de risco."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0E7A42",
          "defaultChannel": "nr-updates"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
